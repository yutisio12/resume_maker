# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY must be set in Cloudflare Pages Environment Variables (NOT here)
# Optional: enforce the hostname returned by siteverify. Defaults to the request host.
# Leave unset in production unless you use a custom domain behind a proxy.
# TURNSTILE_EXPECTED_HOSTNAME=example.com
# NEXT_PUBLIC_TURNSTILE_DISABLED=true
